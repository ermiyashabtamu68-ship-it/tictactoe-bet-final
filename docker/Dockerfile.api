# Dockerfile for the FastAPI backend (api/)
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies needed by psycopg2 (PostgreSQL driver)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY api/app ./app
COPY api/seed_admins.py .
COPY admin ./admin_static
COPY checkers_app ./checkers_static
COPY tictactoe_app ./tictactoe_static
COPY webapp ./webapp_static

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
