# ============================================================
# .env.example
# ============================================================
# Copy this file to ".env" (same folder) and fill in real values.
# NEVER commit the actual ".env" file to GitHub — only this
# example file with placeholder values should be shared publicly.
# ============================================================

# --- Database ---
POSTGRES_PASSWORD=change_this_to_a_strong_password

# --- Admin panel security ---
# A long random string used to sign admin login tokens.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_JWT_SECRET=change_this_to_a_random_secret

# --- Telegram Bot ---
# Get this from @BotFather on Telegram
BOT_TOKEN=123456789:AAAA-your-real-bot-token-here

# --- Payment instructions shown to users during Deposit ---
TELEBIRR_INSTRUCTIONS=Send payment to Telebirr number 09XXXXXXXX (Account name: YOUR NAME)
NIB_BANK_INSTRUCTIONS=Send payment to NIB Bank account 1000XXXXXXXX (Account name: YOUR NAME)
